project: savantenvs/bowtie2
target: build-fasta

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/build-fasta/testsuite

